  "ghostPath3D": [{"x": number, "y": 0.6, "z": number}],
  "ghostAlgorithm": "string — e.g. 'Greedy closest-cell chase' or 'BFS toward Pac-Man'",
  "ghostExplanation": "1-2 sentences explaining how the ghost picks its very next cell (distance metric + tie break)",
  "ghostNextStep": {"x": number, "z": number}
}
rules:
- GHOST RULE: ONLY when the query mentions Pac-Man, ghosts, chasing, or pursuit, ALSO return the ghost fields: ghostPath3D = 5 to 8 points inside -8..8 that trail AND intercept the main path (so the chase is visible); ghostAlgorithm = the pursuit strategy name; ghostExplanation = the exact decision for the ghost's next move (e.g., 'measures Manhattan distance to Pac-Man's cell, moves to the adjacent corridor cell that reduces it; ties broken toward the target'); ghostNextStep = the predicted cell the ghost enters next.
- visualStyle: maze=corridor traversal with walls+pellets (pathfinding), grid=cell-by-cell scan (CSP/backtracking/board algorithms), spiral=spiral sweep (Spiral Matrix, radial patterns), wave=periodic motion, orbit=closed loop (games/deterministic cycles), radial=layer growth (BFS/Dijkstra/flood fill)
- steps: 4 to 8 phases describing execution start-to-end (example for A*: Initialize open/closed sets → expand lowest-f node → evaluate neighbors → update scores/pointers → reconstruct path)
- path3D: 5 to 10 points, x and z within -8..8, y = 0.6
- coordinates as numbers only, no markdown fences.`;

    /* ── Robust JSON extraction: models often mangle the shape of the reply ── */
    function extractJSON(text) {
      if (text == null) throw new Error('Model returned empty output.');
      let t = String(text).replace(/^\uFEFF/, '').trim();
      // Case 1: answer is fenced in a markdown code block
      const fence = t.match(/```(?:json)?\s*([\s\S]*?)```/i);
      if (fence) t = fence[1].trim();

      const tryParse = (s) => { try { return JSON.parse(s); } catch (e) { return undefined; } };
      const isPlainObj = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
      // unwrap a JSON value that is itself a double-encoded JSON string
      const unwrap = (v) => {
        if (isPlainObj(v)) return v;
        if (typeof v === 'string' && /^\s*[{[]/.test(v)) {
          const inner = tryParse(v.trim());
          return isPlainObj(inner) ? inner : undefined;
        }
        return undefined;
      };

      // Case 2: already valid JSON object (arrays/strings are NOT accepted here)
      { const got = unwrap(tryParse(t)); if (got) return got; }

      // Case 3: skim prose, find the balanced { ... } block (brace-aware)
      const first = t.indexOf('{');
      if (first >= 0) {
        let depth = 0, inStr = false, esc = false;
        for (let i = first; i < t.length; i++) {
          const ch = t[i];
          if (esc) { esc = false; continue; }
          if (ch === '\\' && inStr) { esc = true; continue; }
          if (ch === '"') inStr = !inStr;
          if (inStr) continue;
          if (ch === '{') depth++;
          else if (ch === '}') {
            depth--;
            if (depth === 0) {
              const cand = t.slice(first, i + 1);
              { const got = unwrap(tryParse(cand)); if (got) return got; }
              // Case 4: tolerate trailing commas
              const fixed = cand.replace(/,\s*([}\]])/g, '$1');
              { const got = unwrap(tryParse(fixed)); if (got) return got; }
              // Case 5: repair unquoted keys (common model slip)
              const quoteKeys = (s) => s.replace(/([{,]\s*)([A-Za-z_$][\w$]*)(\s*:)/g, '$1"$2"$3');
              { const got = unwrap(tryParse(quoteKeys(fixed))); if (got) return got; }
            }
          }
        }
      }
      throw new Error('No valid JSON object found in the model output.');
    }

    /* ── Model resolution: ask ModelService.ListModels what your key can use ── */
    const MODEL_PREFERENCE = [
      'gemini-2.5-flash',
      'gemini-2.0-flash',
      'gemini-1.5-flash',
      'gemini-2.5-pro',
      'gemini-2.0-pro',
      'gemini-1.5-pro'
    ];
    let modelCacheKey = null;
    let modelCache = null;

    // Local server-side proxy (our Node server forwards to Google so the browser
    // never hits CORS/network blocks). When opened as file:// this stays null.
    const proxyBase = /^https?:$/.test(location.protocol) ? location.origin : null;

    function buildModelList(apiModels) {
      const supported = apiModels
        .filter(m => Array.isArray(m.supportedGenerationMethods) &&
                     m.supportedGenerationMethods.includes('generateContent'))
        .map(m => String(m.name || '').replace(/^models\//, ''))
        .filter(Boolean);
      const byPref = [];
      for (const p of MODEL_PREFERENCE) if (supported.includes(p)) byPref.push(p);
      const rest = supported.filter(m => !byPref.includes(m));
      return byPref.concat(rest).slice(0, 8);
    }

    async function proxyListModels(key) {
      const r = await fetch(`${proxyBase}/api/models?key=${encodeURIComponent(key)}`);
      const data = await r.json().catch(() => ({}));
      if (!r.ok || data.error) throw new Error(data.error ? data.error.message : `HTTP ${r.status}`);
      if (!Array.isArray(data.models)) throw new Error('Malformed model list from proxy.');
      return data.models;
    }

    async function directListModels(key) {
      const r = await fetch(`https://generativelanguage.googleapis.com/v1beta/models?key=${encodeURIComponent(key)}`);
      const data = await r.json().catch(() => ({}));
      if (!r.ok || data.error) throw new Error(data.error ? data.error.message : `HTTP ${r.status}`);
      if (!Array.isArray(data.models)) throw new Error('Malformed model list from API.');
      return data.models;
    }

    async function resolveModels(apiKey) {
      if (modelCache && modelCacheKey === apiKey) return modelCache;
      const attempts = proxyBase
        ? [['local proxy', proxyListModels], ['direct API', directListModels]]
        : [['direct API', directListModels]];
      const errs = [];
      for (const [name, fn] of attempts) {
        try {
          const apiModels = await fn(apiKey);
          modelCache = buildModelList(apiModels);
          modelCacheKey = apiKey;
          log(`Model list via ${name} — found ${apiModels.length}, will try: ${modelCache.join(', ')}`, '#5eead4');
          return modelCache;
        } catch (err) {
          errs.push(`${name}: ${err.message}`);
          console.warn(`ListModels via ${name} failed:`, err.message);
        }
      }
      if (errs.length) console.warn('All model-list channels failed:', errs.join(' | '));
      return MODEL_PREFERENCE.slice();
    }

    // generateContent through proxy first, then direct — whichever works
    async function geminiGenerate(model, key, payload) {
      const errs = [];
      if (proxyBase) {
        try {
          const r = await fetch(`${proxyBase}/api/gemini`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ model, key, payload })
          });
          const data = await r.json().catch(() => ({}));
          if (r.ok && data && !data.error) return { via: 'local proxy', ok: true, data };
          if (r.status < 500 && data && data.error) throw new Error(data.error.message);
          errs.push('proxy: HTTP ' + r.status);
        } catch (e) {
          errs.push('proxy: ' + e.message);
        }
      }
      try {
        const r = await fetch(
          `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(key)}`,
          { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }
        );
        const data = await r.json().catch(() => ({}));
        if (!r.ok || data.error) throw new Error(data.error ? data.error.message : `HTTP ${r.status}`);
        return { via: 'direct', ok: true, data };
      } catch (e) {
        errs.push('direct: ' + e.message);
        throw new Error(errs.join(' | '));
      }
    }

    /* ══════════════════════════════════════════════════════════════════════
       3b. TOPIC-AWARE 3D SCENE RENDERING
    ══════════════════════════════════════════════════════════════════════ */
    const STYLE_INFO = {
      maze:   { label: 'Maze · Pellet Hunt',    reason: 'The agent threads between corridor walls and collects every pellet in visiting order — the same way Pac-Man and maze pathfinding (BFS/DFS/A*) explore walkable corridors toward a goal.' },
      grid:   { label: 'Grid · Board Scan',     reason: 'The agent hops from cell to cell across a board, exactly how constraint solvers like Sudoku backtracking step through candidate cells one at a time.' },
      spiral: { label: 'Spiral · Ring Sweep',   reason: 'The agent winds along an expanding spiral — the same order used by Spiral Matrix traversals and radial neighborhood searches.' },
      wave:   { label: 'Wave · Periodic Loop',  reason: 'The agent rides a periodic oscillating curve, like Lissajous patterns or wave interference, where position is a blend of repeating frequencies.' },
      orbit:  { label: 'Orbit · Closed Cycle',  reason: 'The agent loops a closed trajectory, representing circular patterns: round-robin scheduling, ring buffers, or orbital mechanics.' },
      radial: { label: 'Radial · Flood Bloom',  reason: 'The agent radiates outward from the center, like Dijkstra/BFS layers or flood-fill — visiting everything at distance k before k+1.' }
    };

    function detectStyle(payload, queryText) {
      const q = ((queryText || '') + ' ' + (payload.algorithm || '')).toLowerCase();
      const vs = String(payload.visualStyle || '').toLowerCase();
      if (vs && STYLE_INFO[vs]) return vs;
      if (/(pacman|maze|pellet|ghost|corridor|pathfind|wall)/.test(q)) return 'maze';
      if (/(sudoku|board|grid|puzzle|chess|checker|crossword|matrix cell)/.test(q)) return 'grid';
      if (/(spiral|snail|helix|wind)/.test(q)) return 'spiral';
      if (/(wave|sine|cosine|periodic|lissajous|vibrat|oscillat)/.test(q)) return 'wave';
      if (/(orbit|round.?robin|ring buffer|cycle|circular|rotate|loop)/.test(q)) return 'orbit';
      if (/(flood|bfs|dijkstra|radiat|bloom|nearest|grow)/.test(q)) return 'radial';
      // Syllabus-aware heuristics (Unit III–V)
      if (/(minimax|alpha.?beta|monte carlo|game theory|zero.?sum|adversarial|game tree)/.test(q)) return 'grid';
      if (/(machine learning|supervised|unsupervised|reinforcement|neural|gradient|regression|clust|k.?means|train)/.test(q)) return 'radial';
      if (/(resolution|chaining|logical|proposit|first.?order|theorem|proof|inference|entailment|knowledge base)/.test(q)) return 'spiral';
      if (/(gen ?ai|generative ai|llm|gpt|diffusion|prompt engineer)/.test(q)) return 'wave';
      return 'orbit';
    }

    function clearDecorations() {
      if (!decoGroup) return;
      while (decoGroup.children.length) decoGroup.remove(decoGroup.children[0]);
      pellets.length = 0;
      gridHints.length = 0;
      wpMarkers.length = 0;
      wpPillars.length = 0;
      phaseRibbon = null;
      activeWp = -1;
      const wpInfo = document.getElementById('wp-info');
      if (wpInfo) wpInfo.classList.add('opacity-0');
    }

    function mulberry32(seed) {
      let a = seed >>> 0;
      return function () {
        a |= 0; a = (a + 0x6D2B79F5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    function hashStr(s) {
      let h = 2166136261;
      for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
      return h >>> 0;
    }

    function renderScene(style, points3D) {
      switch (style) {
        case 'maze':   decoMaze(points3D, hashStr(document.getElementById('query-input').value || 'maze')); break;
        case 'grid':   decoGrid(points3D); break;
        case 'spiral': decoSpiralGuide(); break;
        case 'wave':   decoWaveField(); break;
        case 'radial': decoRadial(); break;
        default:       break; // 'orbit' — keep the clean stage, only the trail path
      }
    }

    /* ── Maze (Pac-Man style): room walls + seeded blocks + pellets ── */
    function decoMaze(points3D, seed) {
      const rnd = mulberry32(seed);
      const wallMat = new THREE.MeshStandardMaterial({
        color: 0x2563eb, emissive: 0x1e3a8a, emissiveIntensity: 0.35, roughness: 0.55
      });
      const wallH = 0.55;
      const box = (x, z, w, d) => {
        const m = new THREE.Mesh(new THREE.BoxGeometry(w, wallH, d), wallMat);
        m.position.set(x, wallH / 2, z);
        decoGroup.add(m);
      };
      // Outer room walls
      box(0, -8.35, 17.3, 0.7); box(0, 8.35, 17.3, 0.7);
      box(-8.35, 0, 0.7, 17.3); box(8.35, 0, 0.7, 17.3);

      // Inner wall blocks on a lattice, never overlapping the flight path
      const nearPath = (x, z) => points3D.some(p => Math.hypot(p.x - x, p.z - z) < 1.25);
      const placed = [];
      for (let i = 0; i < 14 && placed.length < 7; i++) {
        const gx = (Math.floor(rnd() * 7) - 3) * 2.1;
        const gz = (Math.floor(rnd() * 7) - 3) * 2.1;
        if (nearPath(gx, gz)) continue;
        if (placed.some(q => Math.hypot(q.x - gx, q.z - gz) < 2.3)) continue;
        placed.push({ x: gx, z: gz });
        box(gx, gz, 0.7 + rnd() * 1.6, 0.7 + rnd() * 1.6);
      }

      // Pellets seeded on the trail — agent eats them as it passes
      const pelletMat = new THREE.MeshBasicMaterial({ color: 0xfacc15 });
      points3D.forEach(p => {
        const m = new THREE.Mesh(new THREE.SphereGeometry(0.09, 10, 10), pelletMat);
        m.position.set(THREE.MathUtils.clamp(p.x, -7.5, 7.5), 0.18, THREE.MathUtils.clamp(p.z, -7.5, 7.5));
        decoGroup.add(m);
        pellets.push(m);
      });
      log(`Maze laid out — ${pellets.length} pellets seeded along the corridor. Eat them all!`, '#facc15');
    }

    /* ── Grid (Sudoku-style): faint 3×3 boxes + cell lines + path markers ── */
    function decoGrid(points3D) {
      const n = 9, size = 15, cell = size / n;
      const off = -size / 2;
      const thin = new THREE.LineBasicMaterial({ color: 0x334155, transparent: true, opacity: 0.65 });
      const thick = new THREE.LineBasicMaterial({ color: 0x475569, transparent: true, opacity: 0.95 });
      const fillMat = new THREE.MeshBasicMaterial({ color: 0x2dd4bf, transparent: true, opacity: 0.045, side: THREE.DoubleSide });
      for (let br = 0; br < n; br += 3) {
        for (let bc = 0; bc < n; bc += 3) {
          const f = new THREE.Mesh(new THREE.PlaneGeometry(cell * 3, cell * 3), fillMat);
          f.rotation.x = -Math.PI / 2;
          f.position.set(off + (bc + 1.5) * cell, 0.015, off + (br + 1.5) * cell);
          decoGroup.add(f);
        }
      }
      const line = (a, b, mat) => {
        const g = new THREE.BufferGeometry().setFromPoints([a, b]);
        decoGroup.add(new THREE.Line(g, mat));
      };
      for (let i = 0; i <= n; i++) {
        const v = off + i * cell;
        const mat = i % 3 === 0 ? thick : thin;
        line(new THREE.Vector3(v, 0.02, off), new THREE.Vector3(v, 0.02, off + size), mat);
        line(new THREE.Vector3(off, 0.02, v), new THREE.Vector3(off + size, 0.02, v), mat);
      }
      const hintMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.55 });
      points3D.forEach(p => {
        const r = new THREE.Mesh(new THREE.RingGeometry(0.28, 0.34, 24), hintMat);
        r.rotation.x = -Math.PI / 2;
        r.position.set(p.x, 0.05, p.z);
        decoGroup.add(r);
        gridHints.push(r);
      });
      log(`Sudoku-style grid laid out (9×9) — ${points3D.length} candidate cells marked on the path.`, '#7dd3fc');
    }

    /* ── Spiral floor guide ── */
    function decoSpiralGuide() {
      const pts = [];
      for (let a = 0; a < Math.PI * 5.5; a += 0.12) {
        const r = a * 0.45;
        if (r > 8) break;
        pts.push(new THREE.Vector3(Math.cos(a) * r, 0.02, Math.sin(a) * r));
      }
      const g = new THREE.BufferGeometry().setFromPoints(pts);
      decoGroup.add(new THREE.Line(g, new THREE.LineBasicMaterial({ color: 0x2dd4bf, transparent: true, opacity: 0.4 })));
      log('Spiral sweep guide drawn on the floor.', '#7dd3fc');
    }

    /* ── Periodic wave field guide ── */
    function decoWaveField() {
      for (let row = -6; row <= 6; row += 1.5) {
        const arr = new Float32Array(41 * 3);
        for (let i = 0; i < 41; i++) {
          const x = -8 + i * 0.4;
          arr[i*3] = x; arr[i*3+1] = 0.02; arr[i*3+2] = row + Math.sin(x * 0.7 + row) * 1.6;
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(arr, 3));
        decoGroup.add(new THREE.Line(g, new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.28 })));
      }
      log('Wave field guide drawn — watch the periodic drifting path.', '#7dd3fc');
    }

    /* ── Radial rings guide ── */
    function decoRadial() {
      const m = new THREE.MeshBasicMaterial({ color: 0x2dd4bf, transparent: true, opacity: 0.22, side: THREE.DoubleSide });
      for (let r = 1; r <= 7; r += 1.5) {
        const ring = new THREE.Mesh(new THREE.RingGeometry(r, r + 0.06, 64), m);
        ring.rotation.x = -Math.PI / 2;
        ring.position.y = 0.02;
        decoGroup.add(ring);
      }
      log('Radial rings laid out — expansion sweeps outward from the center.', '#7dd3fc');
    }

    /* ── HSLA→RGB helper for the comet trail ── */
    function hslRgb(h, s, l) {
      h = ((h % 1) + 1) % 1;
      const c = (1 - Math.abs(2 * l - 1)) * s;
      const x = c * (1 - Math.abs((h * 6) % 2 - 1));
      const m = l - c / 2;
      let r = 0, g = 0, b = 0;
      if (h < 1/6)      { r = c; g = x; }
      else if (h < 2/6) { r = x; g = c; }
      else if (h < 3/6) { g = c; b = x; }
      else if (h < 4/6) { g = x; b = c; }
      else if (h < 5/6) { r = x; b = c; }
      else              { r = c; b = x; }
      return { r: r + m, g: g + m, b: b + m };
    }

    // Rainbow comet: head is bright & saturated, tail melts away — hue sweeps with progress
    function updateTrailColors(hueBase) {
      const col = trailLine.geometry.attributes.color;
      for (let i = 0; i < MAX_TRAIL; i++) {
        const f = 1 - i / MAX_TRAIL; // 1 at the head
        const c = hslRgb(hueBase * 0.55 - 0.15 + f * 0.28, 0.95, 0.18 + f * 0.52);
        col.array[i*3] = c.r; col.array[i*3+1] = c.g; col.array[i*3+2] = c.b;
      }
      col.needsUpdate = true;
    }

    function stepColor(i) { return STEP_COLORS[i % STEP_COLORS.length]; }

    /* ── Numbered decision beacon (canvas sprite, camera-facing) ── */
    function makeNumberSprite(i) {
      const c = document.createElement('canvas');
      c.width = 128; c.height = 128;
      const ctx = c.getContext('2d');
      ctx.beginPath(); ctx.arc(64, 64, 56, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(2,6,23,0.72)'; ctx.fill();
      ctx.lineWidth = 9;
      ctx.strokeStyle = '#' + new THREE.Color(stepColor(i)).getHexString(); ctx.stroke();
      ctx.font = 'bold 62px Consolas, monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillStyle = '#f1f5f9';
      ctx.fillText(String(i + 1), 64, 66);
      const sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(c), transparent: true, depthWrite: false, opacity: 0.96 }));
      sp.scale.set(0.95, 0.95, 1);
      return sp;
    }

    /* ── Phase-colored ground ribbon: shows the traversal order + which step each leg belongs to ── */
    function buildPhaseRibbon(points3D, stCount) {
      if (points3D.length < 2) return;
      const arr = new Float32Array(points3D.length * 3);
      const col = new Float32Array(points3D.length * 3);
      points3D.forEach((p, i) => { arr[i*3] = p.x; arr[i*3+1] = 0.05; arr[i*3+2] = p.z; });
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
      const line = new THREE.Line(geo, new THREE.LineBasicMaterial({ vertexColors: true, transparent: true, opacity: 0.95, blending: THREE.AdditiveBlending }));
      line.frustumCulled = false;
      line.userData = { vertCount: points3D.length, segCount: points3D.length - 1, stepCount: Math.max(1, stCount || 1) };
      decoGroup.add(line);
      phaseRibbon = line;
      updatePhaseRibbon(-1);
    }

    // Each frame: brighten the leg belonging to the current algorithm phase, dim the rest
    function updatePhaseRibbon(activeStep) {
      if (!phaseRibbon) return;
      const col = phaseRibbon.geometry.attributes.color;
      const n = phaseRibbon.userData.vertCount;
      const segs = phaseRibbon.userData.segCount;
      const sts = phaseRibbon.userData.stepCount;
      for (let i = 0; i < n; i++) {
        const seg = Math.min(segs - 1, Math.round((i / (n - 1)) * segs));
        const st = Math.min(sts - 1, Math.floor((seg / segs) * sts));
        const c = new THREE.Color(stepColor(st));
        const d = (activeStep >= 0 && st === activeStep) ? 1 : 0.38;
        col.array[i*3] = c.r * d; col.array[i*3+1] = c.g * d; col.array[i*3+2] = c.b * d;
      }
      col.needsUpdate = true;
    }

    /* ── Numbered waypoint beacons + direction arrows: WHY the path goes each way ── */
    function buildWaypointBeacons(points3D) {
      points3D.forEach((p, i) => {
        const grp = new THREE.Group();
        const col = new THREE.Color(stepColor(i));
        // floor ring
        const ring = new THREE.Mesh(
          new THREE.RingGeometry(0.3, 0.42, 32),
          new THREE.MeshBasicMaterial({ color: col, side: THREE.DoubleSide, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending })
        );
        ring.rotation.x = -Math.PI / 2;
        ring.position.set(p.x, 0.045, p.z);
        // glowing pillar (raycast target + phase intensity)
        const pillar = new THREE.Mesh(
          new THREE.CylinderGeometry(0.06, 0.1, 1.1, 12),
          new THREE.MeshStandardMaterial({ color: col, emissive: col, emissiveIntensity: 0.45, roughness: 0.3 })
        );
        pillar.position.set(p.x, 0.55, p.z);
        pillar.userData = { idx: i };
        // direction cone → shows the chosen next cell
        if (i < points3D.length - 1) {
          const d = new THREE.Vector3(points3D[i+1].x - p.x, 0, points3D[i+1].z - p.z).normalize();
          const cone = new THREE.Mesh(
            new THREE.ConeGeometry(0.13, 0.5, 12),
            new THREE.MeshStandardMaterial({ color: col, emissive: col, emissiveIntensity: 0.6, roughness: 0.3 })
          );
          cone.position.set(p.x + d.x * 0.9, 0.16, p.z + d.z * 0.9);
          cone.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), d);
          grp.add(cone);
        }
        // floating number label
        const num = makeNumberSprite(i);
        num.position.set(p.x, 1.62, p.z);
        grp.add(ring, pillar, num);
        grp.userData = { idx: i, flash: 0 };
        decoGroup.add(grp);
        wpMarkers.push(grp);
        wpPillars.push(pillar);
      });
      log(`${points3D.length} decision waypoints marked — arrows show the chosen traversal order. Hover a number for the why.`, '#a5b4fc');
    }

    function paintWaypoints(active) {
      wpPillars.forEach(p => {
        p.material.emissiveIntensity = p.userData.idx <= active ? 1.25 : 0.45;
      });
    }

    /* ── Ghost chase setup (Pac-Man style queries) ── */
    function setupGhost(payload) {
      const gPath = payload.ghostPath3D;
      if (gPath && Array.isArray(gPath) && gPath.length > 1) {
        ghostWaypoints = gPath.map(p => new THREE.Vector3(
          THREE.MathUtils.clamp(+p.x, -8, 8),
          +p.y || 0.6,
          THREE.MathUtils.clamp(+p.z, -8, 8)
        ));
        ghostSpline = new THREE.CatmullRomCurve3(ghostWaypoints, false, 'centripetal');
        ghostProgress = 0;
        ghostActive = true;
        ghostSpeed = 0.78;
        ghostGroup.visible = true;
        ghostNextMarker.visible = true;
        ghostArrow.visible = true;
        document.getElementById('ghost-algo').textContent = payload.ghostAlgorithm || 'Chase algorithm (BFS / greedy)';
        document.getElementById('ghost-why').textContent = payload.ghostExplanation || 'The ghost keeps moving so its distance to the agent shrinks every turn.';
        document.getElementById('ghost-block').classList.remove('hidden');
        const ns = payload.ghostNextStep;
        const nextText = ns ? `(${Number(ns.x).toFixed(1)}, ${Number(ns.z).toFixed(1)})` : 'computed live — see HUD';
        document.getElementById('ghost-next').textContent = nextText;
        log(`👻 Ghost engaged — chase algorithm: ${payload.ghostAlgorithm || 'greedy chase'}. Predicted next cell ${nextText}.`, '#f87171');
        return true;
      }
      return false;
    }

    /* ── Offline motion plan: guarantees a 3D path + explanation for ANY input ── */
    function genericPath(style) {
      const pts = [];
      const push = (x, z) => pts.push({ x: +x.toFixed(2), y: 0.6, z: +z.toFixed(2) });
      switch (style) {
        case 'maze': { // serpentine corridor scan, row by row
          const xs = [-6, -3, 0, 3, 6];
          for (let row = 0; row < 5; row++) {
            const z = -6 + row * 3;
            const seq = row % 2 === 0 ? xs : [...xs].reverse();
            seq.forEach((x, i) => { if (i === 0 && row > 0) return; push(x, z); });
          }
          break;
        }
        case 'grid': { // row-by-row scan of a 3×3 block
          for (let r = 0; r < 3; r++) for (let c = 0; c < 3; c++) push(-4 + c * 4, 4 - r * 4);
          break;
        }
        case 'spiral': {
          for (let a = 0; a <= Math.PI * 4; a += Math.PI * 0.5) {
            const rr = 0.8 + a * 0.8;
            if (rr > 8) break;
            push(Math.cos(a) * rr, Math.sin(a) * rr);
          }
          break;
        }
        case 'wave': {
          for (let i = 0; i <= 12; i++) { const x = -7 + (14 * i) / 12; push(x, Math.sin(x * 0.8) * 4); }
          break;
        }
        case 'radial': {
          for (let ring = 1; ring <= 4; ring++) {
            const rr = ring * 1.8;
            for (let a = 0; a < Math.PI * 2; a += Math.PI / 2) push(Math.cos(a) * rr, Math.sin(a) * rr);
          }
          break;
        }
        default: { // orbit circle
          for (let i = 0; i <= 12; i++) { const a = (i / 12) * Math.PI * 2; push(Math.cos(a) * 5, Math.sin(a) * 5); }
        }
      }
      return pts.slice(0, 12);
    }

    function fallbackPlan(queryText) {
      const q = (queryText || '').toLowerCase();
      const style = detectStyle({}, queryText);
      const sInfo = STYLE_INFO[style] || STYLE_INFO.orbit;
      let algorithm = sInfo.label;
      if (/(shortest path|shortest route|best path|a\s*\*|a star|dijkstra)/.test(q)) algorithm = 'A* / Dijkstra Shortest-Path Search';
      else if (/(bfs|breadth)/.test(q)) algorithm = 'Breadth-First Search (BFS)';
      else if (/(dfs|depth)/.test(q)) algorithm = 'Depth-First Search (DFS)';
      else if (/(sudoku|backtrack|n-?queens)/.test(q)) algorithm = 'Backtracking (Constraint Satisfaction Search)';
      else if (/(pacman|maze|ghost)/.test(q)) algorithm = 'Greedy Chase + Maze Pathfinding';
      else if (/(minimax|alpha|beta|game playing|tic.?tac)/.test(q)) algorithm = 'Minimax with Alpha-Beta Pruning';
      else if (/(learning|neural|supervised|unsupervised|reinforcement|ml|ai model)/.test(q)) algorithm = 'Supervised Learning from Examples';
      else if (/(sort|merge|quick|divide)/.test(q)) algorithm = 'Merge Sort (Divide & Conquer)';
      else algorithm = sInfo.label + ' — spatial visualization';
      const unit = '';
      const steps = [
        { name: 'Initialize', detail: `Set up the starting state for ${algorithm} and place the agent at the origin of the ${style} scene.` },
        { name: 'Generate candidates', detail: (sInfo.reason.split('.')[0] || 'Enumerate the next possible moves from the current state.') + '.' },
        { name: 'Evaluate & choose', detail: 'Score each candidate and pick the best option (or the next unexplored move) according to the algorithm rule.' },
        { name: 'Apply move', detail: 'Execute the chosen move and update the state; the agent advances one segment along the path.' },
        { name: 'Repeat & arrive', detail: 'Keep moving until the goal is reached, then land and emit arrival ripples.' }
      ];
      return {
        algorithm,
        unit,
        answer: `Offline visualization of "${algorithm}" (${sInfo.label}). This plan was generated locally because the model reply was not usable — the scene still maps the topic to a ${style} layout and the steps below explain the algorithm phase by phase. For full tailored wording, ask again while the AI model is reachable.`,
        motionReason: sInfo.reason,
        codeSnippet: `// ${algorithm} — visualization plan generated locally (offline fallback)`,
        visualStyle: style,
        path3D: genericPath(style),
        steps
      };
    }

    async function processQuery(queryText, source = 'query') {
      const apiKey = document.getElementById('api-key-input').value.trim();
      const summary = document.getElementById('analysis-summary');

      if (!queryText.trim()) return;

      if (source !== 'demo' && !apiKey) {
        summary.innerHTML = `<p class="text-red-400 font-semibold">⚠ Please paste your API key, or hit <span class="text-teal-400">⚡ Live Demo</span>.</p>`;
        return;
      }

      setStatus('Thinking…', 'busy');
      setChip('querying');
      hideBanner();
      steps = []; stepItems = []; lastStep = -1;
      document.getElementById('step-line').textContent = '—';
      // reset ghost chase state
      ghostActive = false;
      ghostSpline = null; ghostWaypoints = [];
      if (ghostGroup) ghostGroup.visible = false;
      if (ghostNextMarker) ghostNextMarker.visible = false;
      if (ghostArrow) ghostArrow.visible = false;
      document.getElementById('ghost-line').textContent = '—';
      document.getElementById('ghost-block').classList.add('hidden');
      document.getElementById('analyze-btn').disabled = true;
      summary.innerHTML = `
        <div class="flex items-center gap-3 text-blue-300 text-xs">
          <div class="w-3 h-3 border-2 border-blue-400 border-t-transparent rounded-full animate-spin"></div>
          <span>Querying neural engine & computing spatial path…</span>
        </div>`;

      let payload;
      let usedFallback = false;
      if (source === 'demo') {
        payload = {
          algorithm: '3D Lissajous Explorer',
          answer: 'A Lissajous path traces independent sinusoidal frequencies on each axis, producing a beautiful interwoven 3D knot. The agent cruises this curve to show how non-linear periodic motion maps a chaotic-looking but fully deterministic trajectory — the same math behind oscilloscope patterns and orbital resonances.',
          motionReason: 'The agent rides a periodic oscillating wave curve — its position blends three repeating frequencies, exactly like Lissajous patterns in physics labs and oscilloscope displays.',
          visualStyle: 'wave',
          unit: 'Unit V · Machine Learning & AI Applications — motion demo',
          steps: [
            { name: 'Choose frequencies', detail: 'The explorer picks distinct sine frequencies for the X and Z axes.' },
            { name: 'Sample the curve', detail: 'The angle t sweeps through a full cycle, sampling points on the Lissajous knot.' },
            { name: 'Project to 3D', detail: 'Each sample maps to XYZ coordinates inside the display volume.' },
            { name: 'Cruise with banking', detail: 'The agent flies the spline, tilting into every turn.' },
            { name: 'Arrive & ripple', detail: 'At the end of the loop the agent lands and emits arrival ripples.' }
          ],
          codeSnippet: `// 3D Lissajous path generator
for (let t = 0; t <= 1; t += 0.02) {
  const ang = t * Math.PI * 2;
  const x = Math.sin(3 * ang) * 6;
  const y = 0.6;
  const z = Math.sin(2 * ang + 1.2) * 6;
  path.push({ x, y, z });
}`,
          path3D: []
        };
        for (let i = 0; i <= 30; i += 3) {
          const ang = (i / 30) * Math.PI * 2;
          payload.path3D.push({
            x: +Math.sin(3 * ang) * 6,
            y: 0.6,
            z: +Math.sin(2 * ang + 1.2) * 6
          });
        }
      } else {
        const models = await resolveModels(apiKey);
        let responseData = null;
        let usedModel = null;
        let lastErrMsg = '';

        for (let i = 0; i < models.length; i++) {
          const currentModel = models[i];
          try {
            if (i > 0) {
              setChip('fallback: ' + currentModel);
              log(`Primary model failed — falling back to ${currentModel}.`, '#fbbf24');
            }
            const { via, ok, data } = await geminiGenerate(currentModel, apiKey, {
              contents: [{ parts: [{ text: `${SYSTEM_PROMPT}\n\nUser Query: ${queryText}` }] }],
              generationConfig: { responseMimeType: 'application/json', temperature: 0.6 }
            });
            if (!ok || !data || data.error) throw new Error(data && data.error ? data.error.message : `HTTP error via ${via}`);
            if (!data.candidates || !data.candidates[0]) throw new Error('Empty response from model.');
            responseData = data;
            responseData.via = via;
            usedModel = currentModel;
            break;
          } catch (err) {
            console.warn(`[${currentModel}] failed:`, err.message);
            lastErrMsg = err.message;
            if (i === models.length - 1) {
              setStatus('Error', 'err');
              setChip('error');
              summary.innerHTML = `<p class="text-red-400 font-semibold">✖ All ${models.length} model(s) failed.<br><span class="text-red-300/80 text-[11px] break-all">Last error: ${esc(lastErrMsg)}</span><br><span class="text-slate-400 text-[11px]">Open the page via the bundled server (http://127.0.0.1:8731/aegis.html) — the local proxy avoids browser CORS blocks. If you still see "Failed to fetch" there, check that the server is running.</span></p>`;
              document.getElementById('analyze-btn').disabled = false;
              return;
            }
          }
        }

        // Collect ONLY answer text — skip Gemini 2.x thinking segments
        const partsText = (content) => (content.parts || [])
          .filter(p => !p.thought)
          .map(p => p.text || '')
          .join('\n');

        const parse = async (content) => {
          const rawText = partsText(content);
          if (!rawText.trim()) throw new Error('model returned an empty reply.');
          let obj;
          try {
            obj = extractJSON(rawText);
          } catch (e) {
            // Self-heal: ask once more for strict JSON
            log(`Output not parseable — requesting a strict-JSON retry from ${usedModel}…`, '#fbbf24');
            const retry = await geminiGenerate(usedModel, apiKey, {
              contents: [{ parts: [{ text: `Your previous answer was not valid JSON. Reply with ONLY a single valid JSON object matching EXACTLY this schema: {"algorithm": string, "unit": string, "answer": string, "motionReason": string, "codeSnippet": string, "visualStyle": "maze|grid|spiral|wave|orbit|radial", "path3D": [{"x": number, "y": 0.6, "z": number}], "steps": [{"name": string, "detail": string}], "ghostPath3D": [{"x": number, "y": 0.6, "z": number}], "ghostAlgorithm": string, "ghostExplanation": string, "ghostNextStep": {"x": number, "z": number}}. Include ghost fields only if the query mentions Pac-Man/ghosts/chasing. Do not use markdown fences and do not add any extra text.` }] }],
              generationConfig: { responseMimeType: 'application/json', temperature: 0.2 }
            });
            if (!retry.ok || !retry.data || retry.data.error) {
              throw new Error(`strict-JSON retry failed via ${retry.via || '?'}: ${(retry.data && retry.data.error && retry.data.error.message) || 'HTTP error'}`);
            }
            obj = extractJSON(partsText(retry.data.candidates[0].content));
            responseData.via = retry.via;
          }
          if (typeof obj !== 'object' || obj === null || Array.isArray(obj)) {
            throw new Error('model returned JSON that is not an object.');
          }
          return { obj, rawFallback: rawText };
        };

        let parsedRes;
        try {
          parsedRes = await parse(responseData.candidates[0].content);
          payload = parsedRes.obj;
          log(`Response (via ${responseData.via || 'unknown'}) received from ${usedModel}. Parsing spatial path…`, '#5eead4');
        } catch (err) {
          console.warn('Parse failed — using offline fallback:', err.message);
          const debug = (parsedRes && parsedRes.rawFallback) ||
            partsText((responseData.candidates[0] || {}).content || { parts: [] });
          document.getElementById('code-view').innerHTML = highlight(debug.slice(0, 6000));
          log(`Model reply wasn't usable JSON — generated the motion plan offline instead. (${esc(err.message)})`, '#fbbf24');
          payload = fallbackPlan(queryText);
          usedFallback = true;
        }
      }

      try {
        // Detect the 3D presentation style from the topic + model hint
        const style = detectStyle(payload, queryText);
        const styleInfo = STYLE_INFO[style] || STYLE_INFO.orbit;
        const algoLabel = payload.algorithm || styleInfo.label;
        const motionReason = payload.motionReason || styleInfo.reason;

        // Render answer with typing effect (sanitized)
        summary.innerHTML = `
          ${usedFallback ? '<div class="mb-2 text-[10px] text-amber-300/90 border border-amber-500/30 bg-amber-950/40 rounded px-2 py-1">⚠ Offline fallback: the model reply was not usable JSON, so this motion plan was generated locally. Raw output is in the code panel.</div>' : ''}
          <div class="mb-2 p-2 bg-blue-950/60 border border-blue-800/80 rounded-lg">
            <span class="text-[10px] uppercase font-bold text-blue-400 block tracking-wider">Active Animation Algorithm</span>
            <span class="text-xs font-semibold text-teal-300" id="ans-algo">${esc(algoLabel)}</span>
            ${payload.unit ? `<span class="text-[9px] uppercase tracking-wider text-indigo-300/80 block mt-1">📚 ${esc(payload.unit)}</span>` : ''}
            <span class="text-[9px] uppercase tracking-wider text-teal-500/80 block mt-1">3D style · ${esc(styleInfo.label)}</span>
          </div>
          <p id="ans-body" class="text-slate-200 text-xs leading-relaxed"></p>
          <div class="border-l-2 border-teal-500/60 pl-2 text-[11px] text-slate-400 leading-relaxed mt-2">
            <span class="font-bold text-teal-400 block mb-0.5">Why this motion path</span>
            <span>${esc(motionReason)}</span>
          </div>
          <div class="mt-2 border border-slate-700/60 rounded-lg overflow-hidden">
            <div class="bg-slate-800/70 px-2 py-1 text-[9px] uppercase tracking-widest text-slate-400 font-bold">Step-by-Step Execution</div>
            <ol id="step-list" class="p-2 space-y-1.5"></ol>
          </div>`;
        typeInto(document.getElementById('ans-body'), payload.answer || 'No explanation returned.', 6);

        // Step-by-step breakdown — synced with flight progress below
        document.getElementById('step-line').textContent = '—';
        const stepListEl = document.getElementById('step-list');
        if (payload.steps && payload.steps.length) {
          steps = payload.steps;
          lastStep = -1;
          stepItems = [];
          stepListEl.innerHTML = steps.map((s, i) =>
            `<li class="step-item"><span class="step-num">${i + 1}</span><div><span class="step-name">${esc(s.name || 'Step ' + (i + 1))}</span>${s.detail ? `<p class="step-detail">${esc(s.detail)}</p>` : ''}</div></li>`
          ).join('');
          stepItems = [...stepListEl.querySelectorAll('.step-item')];
          log(`Step-by-step breakdown loaded — ${steps.length} phases.`, '#7dd3fc');
        } else {
          steps = []; stepItems = [];
          stepListEl.innerHTML = '<li class="step-item"><span class="step-num">—</span><div><span class="step-name" style="color:#64748b;font-style:italic">No step breakdown returned by the model.</span></div></li>';
        }

        // Code view
        const codeEl = document.getElementById('code-view');
        codeEl.innerHTML = highlight(payload.codeSnippet || '// No algorithmic code provided.');
        log(`Algorithm context bound to "${algoLabel}" — 3D style: ${style}.`, '#7dd3fc');
        showBanner(algoLabel);
        document.getElementById('stage-algo-text').textContent = `Algorithm: ${algoLabel} · ${styleInfo.label}`;
        document.getElementById('stage-algo').classList.remove('opacity-0');
        setStatus('Flying path…', 'busy');
        setChip('navigating');

        // Build spline from waypoints
        const pts = payload.path3D;
        if (pts && Array.isArray(pts) && pts.length > 1) {
          const curvePoints = pts.map(p => new THREE.Vector3(
            THREE.MathUtils.clamp(+p.x, -8, 8),
            +p.y || 0.6,
            THREE.MathUtils.clamp(+p.z, -8, 8)
          ));
          clearDecorations();
          renderScene(style, curvePoints);
          setupGhost(payload);          // Pac-Man/ghost chases get an extra pursuer
          splineCurve = new THREE.CatmullRomCurve3(curvePoints, false, 'centripetal');
          animationProgress = 0;
          isFlying = true;
          prevTangentValid = false;
          buildPhaseRibbon(curvePoints, steps.length || curvePoints.length);
          buildWaypointBeacons(curvePoints);
          trail.length = 0;
          eatenCount = 0;
          pelletsDone = false;
          document.getElementById('travel-pct').textContent = '0%';
          log(`Spline built from ${curvePoints.length} waypoints — engaging ${style} flight.`, '#7dd3fc');
        } else {
          // single point — teleport + ripple
          const px = pts && pts.length === 1 ? +pts[0].x : 0;
          const pz = pts && pts.length === 1 ? +pts[0].z : 0;
          clearDecorations();
          renderScene(style, [new THREE.Vector3(px, 0.6, pz)]);
          agentGroup.position.set(px, 0.6, pz);
          spawnRipples(new THREE.Vector3(px, 0.06, pz));
          setStatus('Target placed', 'ok');
          setChip('placed');
        }
      } catch (err) {
        console.error(err);
        setStatus('Error', 'err');
        setChip('error');
        summary.innerHTML = `<p class="text-red-400 font-semibold">✖ ${esc(err.message)}</p>`;
      } finally {
        document.getElementById('analyze-btn').disabled = false;
      }
    }

    /* ══════════════════════════════════════════════════════════════════════
       4. SIMPLE SYNTAX HIGHLIGHTER
    ══════════════════════════════════════════════════════════════════════ */
    function highlight(code) {
      let h = esc(code);
      h = h.replace(/(["'`](?:\\.|[^"'`\\])*["'`])/g, '<span style="color:#4ade80">$1</span>');
      h = h.replace(/(\/\/.*$)/gm, '<span style="color:#64748b">$1</span>');
      h = h.replace(/\b(function|const|let|var|return|if|else|for|while|do|new|class|this|import|from|export|async|await|try|catch|throw|in|of|switch|case|break)\b/g, '<span style="color:#c084fc">$1</span>');
      h = h.replace(/\b(\d+\.?\d*)\b/g, '<span style="color:#f59e0b">$1</span>');
      h = h.replace(/\b(true|false|null|undefined|NaN)\b/g, '<span style="color:#f97316">$1</span>');
      return h;
    }

    /* ══════════════════════════════════════════════════════════════════════
       5. EVENT LISTENERS
    ══════════════════════════════════════════════════════════════════════ */
    window.addEventListener('DOMContentLoaded', () => {
      init3D();
      log('3D renderer initialized — scene ready.', '#5eead4');

      const queryInput = document.getElementById('query-input');
      const analyzeBtn = document.getElementById('analyze-btn');

      analyzeBtn.addEventListener('click', () => processQuery(queryInput.value, 'query'));
      document.getElementById('demo-btn').addEventListener('click', () => processQuery('built-in demo', 'demo'));
      document.getElementById('demo-btn-2').addEventListener('click', () => processQuery('built-in demo', 'demo'));

      document.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const t = btn.dataset.preset;
          queryInput.value = t;
          processQuery(t, 'query');
        });
      });

      queryInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') processQuery(queryInput.value, 'query');
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) processQuery('built-in demo', 'demo');
      });

      // Reset camera
      document.getElementById('reset-cam').addEventListener('click', () => {
        camera.position.set(10, 11, 15);
        controls.target.set(0, 1, 0);
        controls.update();
        followMode = false;
        document.getElementById('follow-cam').textContent = '🎥 Follow';
        log('Camera view reset.', '#94a3b8');
      });

      // Toggle auto orbit
      document.getElementById('toggle-cam').addEventListener('click', function () {
        controls.autoRotate = !controls.autoRotate;
        this.textContent = controls.autoRotate ? '⟳ Stop' : '⟳ Orbit';
        log(`Auto-orbit ${controls.autoRotate ? 'enabled' : 'disabled'}.`, '#94a3b8');
      });

      // Cinematic chase camera — rides behind the agent during flight
      document.getElementById('follow-cam').addEventListener('click', function () {
        followMode = !followMode;
        this.textContent = followMode ? '🎥 Following' : '🎥 Follow';
        if (followMode) {
          controls.autoRotate = false;
          document.getElementById('toggle-cam').textContent = '⟳ Orbit';
        }
        log(`Chase camera ${followMode ? 'engaged — viewing the path from the agent point of view' : 'disengaged'}.`, '#a5b4fc');
      });

      // Flight speed multiplier
      const speedSlider = document.getElementById('speed-slider');
      const speedVal = document.getElementById('speed-val');
      speedSlider.addEventListener('input', () => {
        speedMul = parseFloat(speedSlider.value);
        speedVal.textContent = speedMul.toFixed(1) + '×';
      });

      // Clear log
      document.getElementById('clear-log').addEventListener('click', () => {
        document.getElementById('code-view').innerHTML = '';
        log('Log cleared.', '#64748b');
      });

      // Toggle API key visibility
      document.getElementById('toggle-key').addEventListener('click', function () {
        const input = document.getElementById('api-key-input');
        input.type = input.type === 'password' ? 'text' : 'password';
        this.textContent = input.type === 'password' ? 'show' : 'hide';
      });

      // Voice input
      const micBtn = document.getElementById('mic-btn');
      const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (SpeechRec) {
        const rec = new SpeechRec();
        rec.lang = 'en-US';
        micBtn.addEventListener('click', () => {
          micBtn.classList.replace('text-slate-400', 'text-red-400');
          rec.start();
        });
        rec.onresult = (e) => {
          const transcript = e.results[0][0].transcript;
          queryInput.value = transcript;
          micBtn.classList.replace('text-red-400', 'text-slate-400');
          processQuery(transcript, 'query');
        };
        rec.onerror = () => micBtn.classList.replace('text-red-400', 'text-slate-400');
        rec.onend = () => micBtn.classList.replace('text-red-400', 'text-slate-400');
      } else {
        micBtn.title = 'Voice input not supported in this browser';
        micBtn.classList.add('opacity-40', 'cursor-not-allowed');
      }

      log('Voice input ' + (SpeechRec ? 'ready.' : 'not supported — mic disabled.'), SpeechRec ? '#5eead4' : '#fbbf24');
    });
  </script>
</body>
